<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="App_Data\SpNames.xml" />
        <None Remove="logs\log.txt" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="App_Data\SpNames.LOCAL.xml">
          <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.PROD.xml">
          <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.xml">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="logs\log.txt">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="nlog.config">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
        <PackageReference Include="Fanex.Data" Version="4.3.4.5" />
        <PackageReference Include="Fanex.Data.Repository" Version="4.3.4.5" />
        <PackageReference Include="Fanex.Data.SqlServer" Version="4.3.4.5" />
        <PackageReference Include="Fanex.Logging.Extensions" Version="2.0.2.1" />
        <PackageReference Include="Fanex.Logging.Extensions.Database" Version="2.0.2.1" />
        <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="2.0.2" />
        <PackageReference Include="GO.UserControl.Client.Core" Version="1.0.5" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="NLog.Web.AspNetCore" Version="5.4.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources\ViewResources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>ViewResources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\ViewResources.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>ViewResources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
</Project>