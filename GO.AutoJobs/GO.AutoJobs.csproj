<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <OutputType>exe</OutputType>
        <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
        <None Remove="appsettings.PROD.json" />
        <None Remove="App_Data\SpNames.xml" />
        <None Remove="EmailTemplates\ManpowerForecast\NotiStartToApprover.txt" />
        <None Remove="EmailTemplates\ManpowerForecast\NotiStartToUnitHead.txt" />
        <None Remove="EmailTemplates\ManpowerForecast\NotiStartToVerifier.txt" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.PROD.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="App_Data\SpNames.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="EmailTemplates\ManpowerForecast\NotiStartToApprover.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="EmailTemplates\ManpowerForecast\NotiStartToUnitHead.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="EmailTemplates\ManpowerForecast\NotiStartToVerifier.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="nlog.config">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cronos" Version="0.8.4" />
        <PackageReference Include="Fanex.Data" Version="4.2.5.3" />
        <PackageReference Include="Fanex.Data.Repository" Version="4.2.5.3" />
        <PackageReference Include="Fanex.Data.SqlServer" Version="4.2.5.3" />
        <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.0.1" />
        <PackageReference Include="Fanex.Logging.Extensions.Database" Version="1.0.8" />
        <PackageReference Include="Fanex.Logging.Sentry" Version="1.0.6" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.4" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
        <PackageReference Include="NLog.Web.AspNetCore" Version="5.3.8" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GO.Core\GO.Core.csproj" />
    </ItemGroup>
</Project>
