<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="App_Data\SpNames.xml" />
        <None Remove="logs\log.txt" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="App_Data\SpNames.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="logs\log.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="nlog.config">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.0.1" />
        <PackageReference Include="Fanex.Logging.Extensions.Database" Version="1.0.8" />
        <PackageReference Include="Fanex.Logging.Sentry" Version="1.0.6" />
        <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.4" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="NLog.Web.AspNetCore" Version="5.4.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\GO.Core\GO.Core.csproj" />
        <ProjectReference Include="..\GO.Models\GO.Models.csproj" />
    </ItemGroup>
</Project>