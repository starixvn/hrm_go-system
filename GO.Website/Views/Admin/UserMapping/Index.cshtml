@model bool
@{
    ViewData["Title"] = "User Mapping";
}
@section Breadcrumb {
    <ol class="breadcrumb">
        <li class="breadcrumb-item">Admin Center</li>
        <li class="breadcrumb-item active">User Mapping</li>
    </ol>
}
@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/dev/pages/admin/user-mapping.chunk.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/pro/pages/admin/user-mapping.chunk.css" asp-append-version="true" />
    </environment>
}
@section Scripts {
    @if (Model)
    {
        <script>window.hasHostPermission = true;</script>
    }
    else
    {
        <script>window.hasHostPermission = false;</script>
    }
    <environment include="Development">
        <script src="~/js/dev/pages/admin/user-mapping.chunk.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/pro/pages/admin/user-mapping.chunk.js" asp-append-version="true"></script>
    </environment>
}
<div id="app-container"></div>